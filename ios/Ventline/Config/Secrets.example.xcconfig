// Copy this file to Secrets.xcconfig (same directory) and fill in the values
// from your Supabase project: Dashboard -> Project Settings -> API.
//
// xcconfig cannot contain "//" in values (it starts a comment), so the URL is
// split around it:
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Where a customer magic link points. Leave as-is for local development.
// Same "//" caveat as above.
VENTLINE_SITE_URL = http:/$()/localhost:3000

// Your Apple Developer Team ID — Developer portal -> Membership details.
// Ten characters, e.g. A1B2C3D4E5.
//
// Only needed to build for a device or archive for TestFlight. Left empty the
// app still builds and runs on the simulator, unsigned, which is how it was
// developed. It lives here rather than in project.yml because it identifies an
// account, not the project: hardcoding one makes the repo un-buildable by
// anyone else.
VENTLINE_DEVELOPMENT_TEAM =
